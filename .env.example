# Konfigurasi Server & Domain Publik Cloudflare Tunnel
PORT=3006
PUBLIC_BASE_URL=https://privatmassage.vocpos.id

# Konfigurasi Database PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=pesan_rahasia

# Konfigurasi Lisensi VOC ML (Set VOCML_ENABLED=true pada instalasi klien/cabang)
STORE_NAME=PesanRahasia VOCPOS Pusat
VOCML_ENABLED=true
VOCML_SERVER_URL=https://vocml.vocpos.id
VOCML_PRODUCT=pos
VOCML_MACHINE_ID=

